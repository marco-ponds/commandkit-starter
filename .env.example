# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=
# Injected by Railway; do not set it there. Local default is 3000.
PORT=
# Comma-separated Discord channel IDs to forward to Ember (text or forum channels; threads under them included)
CHANNEL_IDS=
# Ember's webhook URL; must be https.
EMBER_WEBHOOK_URL=
# Bearer token Ember expects on the webhook.
EMBER_WEBHOOK_SECRET=
# Generate with `openssl rand -hex 32` and share with Ember; /send rejects all requests while unset.
SEND_API_SECRET=
